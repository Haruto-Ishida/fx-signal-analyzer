# Discord への通知の設定（見本）
# 使い方：このファイルをコピーして「.env」という名前にし、下の値を入れてください。
# .env は git に入らないようにしてあります（.gitignore）。Webhook URL は他の人に見せないでください。
#
# Webhook URL の作り方：Discord のサーバーの設定 → 連携サービス → ウェブフック → 新しいウェブフック → URL をコピー

# 通知を送るか（true / false）
NOTIFY_ENABLED=false

# Discord の Webhook URL（https://discord.com/api/webhooks/... の形）
DISCORD_WEBHOOK_URL=

# FRED（米国セントルイス連銀の経済データ）の API キー（G10 通貨の検証に使う為替・金利・物価のデータの取得用）
# 作り方：https://fredaccount.stlouisfed.org/ でアカウントを作り、「API Keys」→「Request API Key」で発行（32文字の英数字）
FRED_API_KEY=
